pkgname=juga
pkgver=0.1.0
pkgrel=1
pkgdesc='Live Korean stock quotes and confirmed Toss Securities orders'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'qt6-websockets')
makedepends=('gcc' 'make' 'qt6-base' 'qt6-declarative' 'qt6-websockets')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/juga "$pkgdir/usr/bin/juga"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/juga/LICENSE"
  install -Dm644 "$startdir/juga.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/juga.svg"
  install -Dm644 "$startdir/juga.desktop" "$pkgdir/usr/share/applications/juga.desktop"
}
